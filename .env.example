# Unusual Whales API (Bearer token). Sent with header UW-CLIENT-API-ID: 100001.
UW_API_KEY=
# Telegram bot from @BotFather, and the channel the bot posts to (bot must be admin).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Postgres (Neon or any Postgres 15+).
DATABASE_URL=
# Public URL of the web app, used in Telegram links.
PUBLIC_BASE_URL=
